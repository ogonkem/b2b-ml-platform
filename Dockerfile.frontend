# ── Build stage ────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
# npm ci rejects this lockfile in-container: it was generated on Windows and
# its optional-dependency platform entries (rollup/esbuild native bindings)
# don't line up with linux/musl, even though `npm install` on the host sees
# it as up to date. `npm install` resolves the right platform binaries here.
RUN npm install

COPY frontend/ ./

# Vite bakes VITE_* vars into the JS bundle at build time — the browser (not
# this container) calls the API, so it must resolve wherever the host
# exposes it, same value as frontend/.env used for local dev.
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ── Serve stage ────────────────────────────────────────────────────────────
FROM nginx:alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
