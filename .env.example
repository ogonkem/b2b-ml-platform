# PostgreSQL Secrets
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MinIO Secrets
MINIO_HOST=localhost
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Host used ONLY to sign presigned download URLs handed to the browser (batch
# results). Must be reachable from wherever the user's browser runs — "minio"
# only resolves inside the compose network. Change to your real host/port if
# MinIO isn't exposed on localhost:9000 (e.g. a remote deployment).
MINIO_PUBLIC_ENDPOINT=localhost:9000

# MLflow (reads these to write artefacts to MinIO)
BACKEND_STORE_URI=sqlite:////mlflow-data/mlflow.db
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Read by boto3/dvc_s3 when .dvc/config doesn't hardcode an endpointurl —
# lets the same container image point at a different S3-compatible store
# in prod just by changing this value. Running `dvc` directly from the
# Windows host instead needs AWS_ENDPOINT_URL=http://localhost:9000 in that
# shell, same as every other MinIO-facing hostname in this file.
AWS_ENDPOINT_URL=http://minio:9000

# Airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=
# airflow_dags/ is now reached via the full-repo mount (see docker-compose.yml)
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/project/airflow_dags
# Identity for commit_to_dvc's automated commits — kept distinct from any
# human author in git history/blame.
GIT_AUTHOR_NAME=selastone-mlops-bot
GIT_AUTHOR_EMAIL=mlops-bot@selastone.local
GIT_COMMITTER_NAME=selastone-mlops-bot
GIT_COMMITTER_EMAIL=mlops-bot@selastone.local

# Clickhouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# API
USE_REAL_ARTEFACTS=false
# commercial_bank / microfinance_sacco / informal_digital_lender are static
# tokens that double as tenant_id (verify_token resolves an unrecognized
# static token to itself) — they let a caller authenticate AS one of
# rule_engine/thresholds.py's three seeded demo tenants, needed by
# tests/integration/test_rag_service.py and test_agent_assess.py.
API_TOKENS=
QUOTA_TEST_TOKEN=quota-test-token
MODEL_PATH=/models/best_model.pkl
PIPELINE_PATH=/models/feature_pipeline.pkl
REDIS_HOST=redis
REDIS_PORT=6379

# Auth — user accounts (app.users/app.tenants/app.api_keys in the same
# Postgres instance Airflow uses, kept in a separate "app" schema)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
# Vite dev server + the nginx-served built frontend container
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3001

MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_POLL_INTERVAL=60
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=true
MLFLOW_FLASK_SERVER_SECRET_KEY=
MLFLOW_ALLOW_LOCALHOST_REQUESTS="true"
GUNICORN_CMD_ARGS="--timeout 120 --forwarded-allow-ips=*"

# Paystack billing (paid subscription tiers — see app/plans.py, app/payments.py)
# Test secret key from Settings -> API Keys & Webhooks in your Paystack dashboard.
PAYSTACK_SECRET_KEY=
# Whatever currency your Paystack account actually supports (commonly NGN);
# scripts/setup_paystack_plans.py converts app/plans.py's USD prices into this
# currency using a fixed demo-grade rate.
PAYSTACK_CURRENCY=NGN
PAYSTACK_BASE_URL=https://api.paystack.co
# Filled in by running scripts/setup_paystack_plans.py after PAYSTACK_SECRET_KEY
# and PAYSTACK_CURRENCY are set above.
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_AGENT=

# RAG ingestion/retrieval (rag_service/ingest_task.py) — text-embedding-3-small
# calls, the one network dependency in that pipeline (see the tradeoff
# comment in that file). Required regardless of LLM_PROVIDER below —
# embeddings are OpenAI-only, unrelated to the generation LLM choice.
OPENAI_API_KEY=

# agent/clients.py's generation LLM (POST /v1/agent/assess's synthesis step
# only). LLM_PROVIDER selects which of the three is used:
#   openai — real OpenAI, uses OPENAI_API_KEY above + SYNTHESIS_MODEL (code const)
#   groq   — Groq's OpenAI-compatible endpoint, needs GROQ_API_KEY/GROQ_LLM_MODEL
#   ollama — local Ollama, needs OLLAMA_BASE_URL/OLLAMA_LLM_MODEL, no API key
LLM_PROVIDER=openai
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=llama3.2
# Not yet wired to any code path — no classification step exists in this
# pipeline today. Kept here for whenever one is added.
CLASSIFY_LLM_MODEL=allam-2-7b

# agent/clients.py — in-cluster hostnames (docker-compose service names);
# override if calling out from a different network, e.g. running agent/
# locally against a stack whose other services are exposed on localhost.
SELASTONE_API_URL=http://api:8000
RAG_SERVICE_URL=http://rag_service:8001
RULE_ENGINE_URL=http://rule_engine:8002