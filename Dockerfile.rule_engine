FROM python:3.12-slim

WORKDIR /app

# Deliberately its own requirements file, not requirements.txt — this
# service has no need for the ML/RAG stack (xgboost, pdfplumber, openai,
# ...) that image carries; see requirements-rule-engine.txt.
COPY requirements-rule-engine.txt .
RUN pip install --no-cache-dir -r requirements-rule-engine.txt

# app/ is needed for app.auth.verify_token — reused directly, not
# reimplemented (same as rag_service).
COPY app/ ./app/
COPY rule_engine/ ./rule_engine/

CMD ["uvicorn", "rule_engine.main:app", "--host", "0.0.0.0", "--port", "8002", "--reload"]
