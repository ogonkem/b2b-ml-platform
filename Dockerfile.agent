FROM python:3.12-slim

WORKDIR /app

COPY requirements-agent.txt .
RUN pip install --no-cache-dir -r requirements-agent.txt

# app/ is needed for app.auth.verify_token — reused directly, not
# reimplemented (same as rag_service and rule_engine).
COPY app/ ./app/
COPY agent/ ./agent/

CMD ["uvicorn", "agent.main:app", "--host", "0.0.0.0", "--port", "8003", "--reload"]
