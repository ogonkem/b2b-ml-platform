FROM python:3.12-slim

WORKDIR /app

# Build tools required by shap (C extensions) and other compiled packages
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY app/ ./app/
COPY shared/ ./shared/
COPY celery_worker/ ./celery_worker/
# rag_service/ingest_task.py is registered on this same Celery app (see
# celery_worker/celery_app.py's `include` list) — the celery_worker
# container built from this image needs it importable too.
COPY rag_service/ ./rag_service/

# Run uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]